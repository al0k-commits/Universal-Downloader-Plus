# ─────────────────────────────────────────────────────────────────────
# Universal Downloader Plus — monorepo .gitignore
# Sub-projects: desktop/ (PyQt6 + PyInstaller) and android/ (Expo/RN)
# ─────────────────────────────────────────────────────────────────────

# ── Python bytecode / caches ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Packaging & build artifacts (PyInstaller) ──
build/
dist/
*.spec
*.spec~
*.manifest
*.egg-info/
*.egg
*.whl
.eggs/
develop-eggs/
downloads.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
MANIFEST

# ── Virtual environments ──
.env
.venv/
venv/
ENV/
env/
.venv.bak/
venv.bak/

# ── Test / coverage / linters ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/
nosetests.xml
coverage.xml

# ── Editors / OS cruft ──
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── AI assistant folders ──
.claude/
.claude.json
.cursorrules
.cursor/
.aider/
.codeium/
.kilo/
.kilocode/
.mimocode/
.github/copilot/

# ── Secrets / local config ──
*.key
*.pem
secrets.json
config.local.json
.env.local

# ═════════════════════════════════════════════════════════════════════
# desktop/ — PyQt6 app
# ═════════════════════════════════════════════════════════════════════

# Standalone binaries: ffmpeg / ffplay / ffprobe / yt-dlp
desktop/ffmpeg/
!desktop/ffmpeg/
!desktop/ffmpeg/README.md
ffmpeg.exe
ffplay.exe
ffprobe.exe
ffprobe
ffplay
ffmpeg
yt-dlp
yt-dlp.exe
yt-dlp_linux
yt-dlp_macos
yt-dlp_win.exe
ffmpeg.zip
ffmpeg-btbn.tar.xz

# Installer scratch / output
desktop/obj/
desktop/artifacts/

# Compiled / binary executables
*.exe
*.bin
*.dll
*.dylib
*.app
*.msi
*.dmg
*.deb

# Downloaded media & thumbnails (app output)
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.mp3
*.m4a
*.aac
*.wav
*.flac
*.ogg
*.opus
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Keep legit image assets that ship with the app
!desktop/src/universal_downloader/resources/**

# ═════════════════════════════════════════════════════════════════════
# android/ — Expo / React Native app
# ═════════════════════════════════════════════════════════════════════
node_modules/
npm-debug.*
yarn-error.log
yarn-debug.log
*.orig.*
*.tgz

# Expo
.expo/
.expo-shared/
expo-env.d.ts
web-build/
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/.cxx/
android/app/src/main/res/raw/

# Native prebuild output (generated by `expo prebuild`, git-ignored so
# only the JS source is committed)
android/android/
android/ios/

# EAS / fastlane
eas.json.local
.expo-google-sign-in.json
.expo-plist.json

# Gradle
*.keystore
*.jks
*.properties.bak

# APK / AAB outputs
*.apk
*.aab
android/artifacts/
