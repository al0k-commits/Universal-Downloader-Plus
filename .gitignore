# ─────────────────────────────────────────────────────────────────────
# Universal Downloader Plus — .gitignore
# Python / PyQt6 / PyInstaller / yt-dlp / ffmpeg project
# ─────────────────────────────────────────────────────────────────────

# ── Python bytecode / caches ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Packaging & build artifacts (PyInstaller) ──
build/
dist/
*.spec
*.spec~
*.manifest
*.egg-info/
*.egg
*.whl
.eggs/
develop-eggs/
downloads.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
.installed.cfg
MANIFEST

# ── Virtual environments ──
.env
.venv/
venv/
ENV/
env/
.venv.bak/
venv.bak/

# ── Test / coverage / linters ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/
nosetests.xml
coverage.xml

# ── Editors / OS cruft ──
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── AI assistant folders ──
.claude/
.claude.json
.cursorrules
.cursor/
.aider/
.codeium/
.kilo/
.kilocode/
.mimocode/
.github/copilot/

# ── Secrets / local config ──
*.key
*.pem
secrets.json
config.local.json
.env.local

# ── Standalone binaries: ffmpeg & yt-dlp ──
ffmpeg/
!ffmpeg/
!ffmpeg/README.md
ffmpeg.exe
ffmpeg.zip
ffprobe.exe
ffprobe
yt-dlp
yt-dlp.exe
yt-dlp_linux
yt-dlp_macos
yt-dlp_win.exe

# ── Compiled / binary executables ──
*.exe
*.bin
*.dll
*.dylib
*.app

# ── Downloaded media & thumbnails (app output) ──
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.mp3
*.m4a
*.aac
*.wav
*.flac
*.ogg
*.opus
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Keep legit image assets that ship with the app
!src/universal_downloader/resources/**
