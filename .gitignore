# ─────────────────────────────────────────────────────────────────────
# Universal Downloader — .gitignore
# Python / PyQt6 / PyInstaller / yt-dlp / ffmpeg project
# ─────────────────────────────────────────────────────────────────────

# ── Byte-compiled / cached Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads.eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Packaging / build artifacts (PyInstaller) ──
build/
dist/
*.spec
*.manifest
*.spec~

# ── Virtual environments ──
.env
.venv/
venv/
ENV/
env/
.venv.bak/
venv.bak/

# ── Distribution / install logs ──
pip-log.txt
pip-delete-this-directory.txt
*.whl

# ── Test / coverage ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/
nosetests.xml
coverage.xml

# ── Editors / OS cruft ──
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── AI assistant folders ──
.claude/
.claude.json
.cursorrules
.cursor/
.aider/
.codeium/
.kilo/
.kilocode/
.mimocode/
.github/copilot/

# ── Secrets / local config ──
*.key
*.pem
secrets.json
config.local.json
.env.local

# ── Binaries, standalone downloaders & media (NEVER commit) ──
*.exe
*.bin
*.dll
*.so
*.dylib
*.app

# ffmpeg / ffprobe / yt-dlp standalone binaries
ffmpeg/
ffmpeg.exe
ffmpeg.zip
ffprobe.exe
yt-dlp
yt-dlp.exe
yt-dlp_linux
yt-dlp_macos
yt-dlp_win.exe

# Downloaded media & thumbnails (app output)
*.mp4
*.mkv
*.webm
*.mp3
*.m4a
*.aac
*.wav
*.flac
*.ogg
*.opus
*.jpg
*.jpeg
*.png
*.gif
*.webp
!src/universal_downloader/resources/**
